{
    "tags": {
      "allowUnknownTags": true
    },
    "source": {
      "include": ["src", "src/integrations", "src/scripts"],
      "includePattern": ".js$",
      "excludePattern": "(node_modules/|docs)"
    },
    "opts": {
      "encoding": "utf8",
      "destination": "./docs",
      "recurse": true
    }
  }
  